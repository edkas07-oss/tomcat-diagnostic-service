{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tomcat-monitoring.invalid/schemas/rulepack-v1.schema.json",
  "title": "Tomcat Diagnostic Service Declarative Rulepack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "branch",
    "ruleName",
    "targetSource",
    "pattern",
    "assessment",
    "classification",
    "confidence",
    "recommendedActions"
  ],
  "properties": {
    "branch": {
      "type": "string",
      "pattern": "^TD-[0-9]{2,}$",
      "minLength": 5,
      "maxLength": 16
    },
    "ruleName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 3,
      "maxLength": 64
    },
    "category": {
      "type": "string",
      "enum": [
        "jvm_memory",
        "concurrency_threading",
        "database_persistence",
        "network_integration",
        "application_lifecycle",
        "storage_os_limits",
        "security_session",
        "general"
      ]
    },
    "targetSource": {
      "type": "string",
      "enum": ["local_file", "prometheus", "collector", "application_health", "any"]
    },
    "pattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "assessment": {
      "type": "string",
      "minLength": 5,
      "maxLength": 256
    },
    "classification": {
      "type": "string",
      "enum": [
        "confirmed_cause",
        "probable_cause",
        "possible_cause",
        "contributing_factor",
        "symptom",
        "undetermined"
      ]
    },
    "confidence": {
      "type": ["string", "null"],
      "enum": ["high", "medium", "low", null]
    },
    "recommendedActions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 500
      }
    },
    "createdBy": {
      "type": "string",
      "maxLength": 64
    }
  }
}
